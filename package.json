{
  "name": "lunar-ice-scout",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous lunar ice prospecting simulator with Monad Testnet mission logs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/navigation.test.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.js --network monadTestnet"
  },
  "dependencies": {
    "ethers": "^6.13.5",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "chai": "^4.5.0",
    "hardhat": "^2.22.19",
    "vite": "^6.1.0",
    "dotenv": "^16.4.5",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8"
  }
}
