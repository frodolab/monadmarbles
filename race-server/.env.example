# Railway provides PORT automatically.
PORT=3001
# Comma-separated permitted browser origins. Set this on Railway.
WEB_ORIGIN=https://monadmarbles-production.up.railway.app,http://localhost:5173
# Set a private operator PIN in Railway. Without one, demo controls are public.
OPERATOR_PIN=
MAX_PLAYERS=48

# Beta 4B read-only Monad Testnet verification. Optional; demo mode remains
# unchanged unless explicitly configured. NEVER put private keys in this file.
MONAD_CONTRACT_ADDRESS=0x9fB46e07dFcEad9B51799aD4B5A5b8a2c254c55B
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_DEPLOY_BLOCK=80033623
MONAD_MIN_CONFIRMATIONS=2

# On-chain paid admission is NEVER enabled just by setting a contract address.
# For isolated local/staging integration tests only:
# MONAD_ENTRY_MODE=onchain
# A non-empty OPERATOR_PIN is required when the mode is onchain.
# Never enable on the production demo service until end-to-end tests pass.

# New contract V2 ONLY. Do not enable this with the legacy V1 address.
# Set only after attaching a Railway volume to /data and authorizing the relayer:
# MONAD_AUTOPAYOUT_ENABLED=true
# MONAD_SETTLEMENT_DIR=/data
# MONAD_SETTLER_PRIVATE_KEY=SET_ONLY_IN_PROTECTED_RAILWAY_VARIABLE_NOT_GIT
# MONAD_CONTRACT_ADDRESS=0xNEW_V2_CONTRACT_ADDRESS
# MONAD_DEPLOY_BLOCK=NEW_V2_DEPLOYMENT_BLOCK
